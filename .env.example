# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon connection string — Dashboard → your project → Connection string.
# Use the pooled ("-pooler") host.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Signing key for the session cookie. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client credentials (Google Cloud console → APIs & Services →
# Credentials → OAuth client ID → Web application).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google account emails allowed to sign in. Leave empty and
# nobody gets in — the allowlist fails closed on purpose.
ALLOWED_GOOGLE_EMAILS="ushakov.vladyslav.v@gmail.com"

# ── Telegram Mini App ────────────────────────────────────────────────
# Leave both empty and Telegram sign-in is simply off: the bot token is what
# verifies the signature, and an empty id list admits nobody. The browser and
# its Google sign-in are unaffected either way.

# From @BotFather: /newbot, or /token for a bot you already have.
TELEGRAM_BOT_TOKEN=""

# Comma-separated numeric Telegram user ids allowed in. Ask @userinfobot for
# yours. Fails closed, like the Google allowlist.
ALLOWED_TELEGRAM_IDS=""

# Optional. The account a Telegram session attaches to, so the Mini App and the
# browser show the same goals. Defaults to the first ALLOWED_GOOGLE_EMAILS
# entry, which is almost always what you want.
TELEGRAM_LINK_EMAIL=""
