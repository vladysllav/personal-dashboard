# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon connection string — Dashboard → your project → Connection string.
# Use the pooled ("-pooler") host.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Signing key for the session cookie. Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app credentials (Settings → Developer settings → OAuth Apps).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated GitHub logins allowed to sign in. Leave empty and nobody
# gets in — the allowlist fails closed on purpose.
ALLOWED_GITHUB_LOGINS="vladysllav"
